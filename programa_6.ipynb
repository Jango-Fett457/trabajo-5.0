      "source": [
        "temp_fahrenheit = [80, 72, 95, 82, 79, 72, 85]\n",
        "temp_celsius = []\n",
        "\n",
        "for temp_f in temp_fahrenheit:\n",
        "  temp_c = (temp_f - 32) * 5/9\n",
        "  temp_celsius.append(round(temp_c, 2))\n",
        "\n",
        "print(\"Temperatures in Fahrenheit:\", temp_fahrenheit)\n",
        "print(\"Temperatures in Celsius:\", temp_celsius)"
      ],
      "execution_count": 1,
      "outputs": [
        {
          "output_type": "stream",
